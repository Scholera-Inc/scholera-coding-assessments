# Copy to .env.local. These are local Supabase defaults; `supabase start` prints them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `supabase start`>

# Server-side only.
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `supabase start`>

# Used by the admin institution switcher.
NEXT_PUBLIC_SUPABASE_SERVICE_KEY=<service_role key from `supabase start`>
